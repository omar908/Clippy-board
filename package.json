{
  "name": "clippy-board",
  "private": true,
  "version": "0.3.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:debug": "tauri build --debug --no-bundle -- --locked --timings",
    "build:release:signed": "node scripts/build-signed-release.mjs",
    "test": "vitest run src",
    "preview": "vite preview",
    "tauri": "tauri",
    "test:release": "node --test scripts/release-plan.node.mjs",
    "test:layout": "playwright test",
    "typecheck:layout": "tsc -p tests/layout/tsconfig.json"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-global-shortcut": "^2.3.2",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2",
    "@types/node": "^22.20.5",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.5"
  }
}
